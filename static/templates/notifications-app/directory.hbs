<ol class="directory-list plain">
    {{#each entries}}
        <li class="directory-item entry notification-entry flexcol dfreds-notification-{{this.type}}" data-entry-id="{{this.id}}">
            <div class="notification-entry-header flexrow">
                <i class="notification-entry-icon {{this.icon}}"></i>
                <span class="notification-entry-message">{{{this.message}}}</span>
            </div>
            <time class="notification-entry-time" data-tooltip="{{this.timestamp}}">{{this.timeSince}}</time>
            {{#if this.actions.length}}
                <div class="notification-entry-actions flexrow">
                    {{#each this.actions}}
                        <button type="button" data-action="runAction" data-notification-id="{{../id}}"
                            data-action-index="{{this.index}}">
                            {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
                            {{this.label}}
                        </button>
                    {{/each}}
                </div>
            {{/if}}
        </li>
    {{else}}
        <li class="directory-item notification-empty">{{localize "DFredsNotifications.NoNotifications"}}</li>
    {{/each}}
</ol>
